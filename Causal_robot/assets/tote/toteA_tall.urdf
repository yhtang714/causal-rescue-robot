<?xml version="1.0"?>
<robot name="toteA_tall">
  <!--
    Taller tote variant (v521).
    Z scale 1.2 (v526) — slightly taller than default but lower than v521 (1.8)
    so cubes are easier to reach. Reduces visual obstruction during demos.
  -->
  <material name="Blanc">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>
  <link concave="yes" name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="ToteA.L.obj" scale="0.8 0.8 1.2"/>
      </geometry>
      <material name="Blanc"/>
    </visual>
    <collision concave="yes">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="ToteA.L.Proxy.obj" scale="0.8 0.8 1.2"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.3608"/>
      <origin xyz="0 0 0.0765" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
    <contact>
      <lateral_friction value="1.0"/>
    </contact>
  </link>
</robot>
