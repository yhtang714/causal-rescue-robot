<?xml version="1.0"?>
<robot name="custom">
  <!--
    4cm cube, 0.05 kg. Same v521 inertia fix as dumbbell.
    Old inertia was ixx=iyy=izz=1.0 (~50000x too large for this object).
    Correct: I = (1/12) * m * (a^2 + b^2) ~ 1.3e-5
  -->
  <material name="Blanc">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="cube.obj" scale="1 1 1"/>
      </geometry>
      <material name="Blanc"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="cube.obj" scale="1 1 1"/>
      </geometry>
    </collision>
    <contact>
      <lateral_friction value="0.9"/>
      <rolling_friction value="0.005"/>
      <spinning_friction value="0.005"/>
    </contact>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
       <mass value="0.05"/>
       <inertia ixx="1.3e-5" ixy="0" ixz="0" iyy="1.3e-5" iyz="0" izz="1.3e-5"/>
    </inertial>
  </link>
</robot>
